{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anime Universe",
  "version": "2.25.0",
  "identifier": "com.animeuniverse.app",
  "build": {
    "frontendDist": "https://animeuniverse.pages.dev/?tauri=1",
    "devUrl": "https://animeuniverse.pages.dev/?tauri=1"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ANIME UNIVERSE",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 640,
        "decorations": true,
        "resizable": true,
        "backgroundColor": "#09090f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
