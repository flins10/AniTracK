{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for ANIME UNIVERSE remote Cloudflare Pages WebView across Android, Windows, and macOS",
  "platforms": ["linux", "macOS", "windows", "iOS", "android"],
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://animeuniverse.pages.dev",
      "https://animeuniverse.pages.dev/*",
      "https://*.animeuniverse.pages.dev/*",
      "https://*.run.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "allow-anime-commands"
  ]
}
