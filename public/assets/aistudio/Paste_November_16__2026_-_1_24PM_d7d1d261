<script>
// ===== FAKE DATA (real anime, fake user state) =====
const anime = {
  solo: { title:'Solo Leveling', jp:'俺だけレベルアップな件', poster:'p-solo', watched:11, total:13, aired:12, userRating:9, userNote:'Animation broke me. Peak.', category:'cinema', nextHours:62 },
  jjk: { title:'Jujutsu Kaisen', jp:'呪術廻戦', poster:'p-jjk', watched:45, total:47, aired:45, userRating:8, userNote:null, category:'avg', nextHours:148 },
  op: { title:'One Piece', jp:'ワンピース', poster:'p-op', watched:1105, total:null, aired:1105, userRating:null, userNote:null, category:null, nextHours:168 },
  frieren: { title:'Frieren: Beyond Journey\'s End', jp:'葬送のフリーレン', poster:'p-frieren', watched:28, total:28, aired:28, userRating:10, userNote:'Masterpiece.', category:'worth', nextHours:null },
  dungeon: { title:'Delicious in Dungeon', jp:'ダンジョン飯', poster:'p-dungeon', watched:18, total:24, aired:18, userRating:null, userNote:null, category:null, nextHours:32 },
  dandadan: { title:'Dandadan', jp:'ダンダダン', poster:'p-dandadan', watched:8, total:12, aired:8, userRating:8, userNote:null, category:'worth', nextHours:98 },
  demon: { title:'Demon Slayer', jp:'鬼滅の刃', poster:'p-demon', watched:55, total:55, aired:55, userRating:9, userNote:null, category:null, nextHours:null },
  chainsaw: { title:'Chainsaw Man', jp:'チェンソーマン', poster:'p-chainsaw', watched:12, total:12, aired:12, userRating:null, userNote:null, category:'waste', nextHours:null },
  aot: { title:'Attack on Titan', jp:'進撃の巨人', poster:'p-aot', watched:87, total:87, aired:87, userRating:null, userNote:null, category:'boring', nextHours:null },
  spy: { title:'Spy × Family', jp:'スパイファミリー', poster:'p-spy', watched:37, total:37, aired:37, userRating:8, userNote:null, category:null, nextHours:null },
  bocchi: { title:'Bocchi the Rock!', jp:'ぼっち・ざ・ろっく！', poster:'p-bocchi', watched:12, total:12, aired:12, userRating:9, userNote:'Comfort show.', category:'worth', nextHours:null },
  fmab: { title:'Fullmetal Alchemist: Brotherhood', jp:'鋼の錬金術師', poster:'p-fmab', watched:64, total:64, aired:64, userRating:10, userNote:'Perfect.', category:'cinema', nextHours:null }
};

// Load persisted
const stored = localStorage.getItem('livtrak_final');
if (stored) {
  try {
    const saved = JSON.parse(stored);
    Object.keys(saved).forEach(k => { if (anime[k]) Object.assign(anime[k], saved[k]); });
  } catch(e) {}
}

function save() {
  localStorage.setItem('livtrak_final', JSON.stringify(anime));
}

let currentId = 'solo';

// ===== NAV =====
function go(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + id).classList.add('active');
  document.querySelectorAll('.navitem').forEach(n => n.classList.toggle('active', n.dataset.screen === id));
  if (id === 'explore') renderExplore();
  if (id === 'library') renderLibrary();
}

// ===== DAY FILTER =====
function selectDay(el, day) {
  document.querySelectorAll('.day-pill').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  const cards = document.querySelectorAll('#homeGrid .poster-card');
  let visible = 0;
  cards.forEach(c => {
    const show = day === 'all' || c.dataset.day === day;
    c.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  const dayNames = { all:'All anime', mon:'Monday', tue:'Tuesday', wed:'Wednesday', thu:'Thursday', fri:'Friday' };
  document.querySelector('.selected-day-header h2').textContent = dayNames[day];
  document.querySelector('.sdh-count').textContent = visible + ' shows';
}

// ===== EPISODE =====
function changeEp(id, delta) {
  const a = anime[id];
  const max = a.total || Infinity;
  const nv = Math.max(0, Math.min(max, a.watched + delta));
  if (nv === a.watched) {
    showToast(delta > 0 ? 'Already at last episode' : 'Already at 0', 'error');
    return;
  }
  a.watched = nv;
  save();
  renderCard(id);
  if (currentId === id) renderDetail();
}

function setEp(id) {
  const a = anime[id];
  const input = prompt(`Set episode for "${a.title}"\nCurrently: ${a.watched}/${a.total || '∞'}`, a.watched);
  if (input === null) return;
  let v = parseInt(input);
  if (isNaN(v) || v < 0) { showToast('Invalid number', 'error'); return; }
  if (a.total && v > a.total) { showToast('Max is ' + a.total, 'error'); return; }
  a.watched = v;
  save();
  renderCard(id);
  if (currentId === id) renderDetail();
  showToast('Set to EP ' + v, 'success');
}

function renderCard(id) {
  // Simple re-render of the ep count in home
  const cards = document.querySelectorAll('#homeGrid .poster-card');
  cards.forEach(c => {
    const title = c.querySelector('.pc-title');
    if (title && title.textContent.includes(anime[id].title.split(':')[0])) {
      const count = c.querySelector('.ep-count');
      if (count) {
        count.innerHTML = `${anime[id].watched}<span class="total">/${anime[id].total || '∞'}</span>`;
      }
      const pct = anime[id].total ? Math.min(100, anime[id].watched / anime[id].total * 100) : 95;
      c.querySelector('.progress-bar .fill').style.width = pct + '%';
    }
  });
}

// ===== DETAIL =====
function openDetail(id) {
  currentId = id;
  renderDetail();
  go('detail');
}

function renderDetail() {
  const a = anime[currentId];
  document.getElementById('detailHeroBg').className = 'dh-bg ' + a.poster;
  document.getElementById('detailTitle').textContent = a.title;
  document.getElementById('detailJp').textContent = a.jp;
  document.getElementById('detailWatched').textContent = a.watched;
  document.getElementById('detailTotal').textContent = a.total || '∞';
  document.getElementById('detailAired').textContent = a.aired;
  const pct = a.total ? Math.min(100, a.watched/a.total*100) : 95;
  document.getElementById('detailProgress').style.width = pct + '%';
  
  if (a.total && a.watched >= a.total) {
    document.getElementById('detailNext').textContent = '✓';
    document.getElementById('detailCd').textContent = 'Done';
  } else if (a.nextHours) {
    document.getElementById('detailNext').textContent = a.aired + 1;
    document.getElementById('detailCd').textContent = fmtH(a.nextHours * 3600);
  } else {
    document.getElementById('detailNext').textContent = a.aired + 1;
    document.getElementById('detailCd').textContent = 'TBD';
  }
}

function detailChangeEp(delta) {
  changeEp(currentId, delta);
  renderDetail();
}

// ===== EXPLORE =====
function renderExplore() {
  const ids = ['solo','frieren','jjk','op','aot','chainsaw','dandadan','fmab','dungeon','demon'];
  document.getElementById('exploreGrid').innerHTML = ids.map(id => {
    const a = anime[id];
    return `
      <div class="poster-card" onclick="openDetail('${id}')">
        <div class="poster ${a.poster}">
          <div class="poster-title-art">${a.title.split(' ').slice(0,2).join('<br>').toUpperCase()}</div>
          <span class="pc-score">★ ${(7.5 + Math.random()*1.5).toFixed(1)}</span>
        </div>
        <div class="pc-info">
          <div class="pc-title">${a.title}</div>
          <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--ash);margin-top:6px">
            <span>${a.watched}/${a.total||'∞'}</span>
            <span style="color:var(--gold)">${a.userRating ? '★ '+a.userRating : '☆'}</span>
          </div>
        </div>
      </div>
    `;
  }).join('');
}

// ===== LIBRARY =====
function renderLibrary() {
  const catLabels = { cinema:'🎬 Absolute cinema', worth:'✓ Worth watching', avg:'◐ Average', boring:'😴 Boring', waste:'✕ Waste of time' };
  const ids = Object.keys(anime).filter(id => anime[id].userRating || anime[id].category);
  document.getElementById('libraryList').innerHTML = ids.map(id => {
    const a = anime[id];
    return `
      <div class="lib-item" onclick="openDetail('${id}')">
        <div class="lib-poster ${a.poster}"></div>
        <div class="lib-info">
          <div class="lib-title">${a.title}</div>
          <div class="lib-meta">EP ${a.watched}/${a.total||'∞'} · ${a.userRating ? '★ '+a.userRating : 'Not rated'}</div>
          ${a.category ? `<div class="lib-category ${a.category}">${catLabels[a.category]}</div>` : ''}
        </div>
      </div>
    `;
  }).join('');
}

// ===== COUNTDOWN =====
function fmtH(seconds) {
  if (seconds <= 0) return 'Airing now';
  const d = Math.floor(seconds/86400);
  const h = Math.floor((seconds%86400)/3600);
  const m = Math.floor((seconds%3600)/60);
  if (d > 0) return `${d}d ${h}h`;
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m`;
}

function updateCountdowns() {
  const now = Date.now();
  document.querySelectorAll('[data-cd]').forEach(el => {
    const id = el.dataset.cd.replace('ep-', '');
    const a = anime[id];
    if (!a || !a.nextHours) { el.textContent = 'TBD'; return; }
    // Fake: countdown reduces as time passes in real-time
    const target = window._startTime + a.nextHours * 3600000;
    const remaining = (target - now) / 1000;
    el.textContent = remaining <= 0 ? 'Airing now' : fmtH(remaining);
  });
  // Detail
  if (currentId && anime[currentId] && anime[currentId].nextHours) {
    const a = anime[currentId];
    const target = window._startTime + a.nextHours * 3600000;
    const remaining = (target - Date.now()) / 1000;
    const el = document.getElementById('detailCd');
    if (el && el.textContent !== 'Done') el.textContent = remaining <= 0 ? 'Airing now' : fmtH(remaining);
  }
}

window._startTime = Date.now();
setInterval(updateCountdowns, 1000);
setTimeout(updateCountdowns, 100);

// ===== TOAST =====
let toastTimer;
function showToast(msg, type='info') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show ' + type;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2200);
}

// Init
renderExplore();
renderLibrary();
setTimeout(updateCountdowns, 500);
</script>
